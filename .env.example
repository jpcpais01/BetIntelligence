# Required for real AI analysis. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required for football analysis (Sports). Get a free-tier key at https://www.api-football.com/ —
# sign up, then use the key from your dashboard with the direct v3.football.api-sports.io host
# (not the RapidAPI host, which needs different headers). Football's research step is built
# entirely from this API's structured match data (form, injuries, fixture status/score) with no
# fallback to web search if a team or fixture can't be resolved.
API_FOOTBALL_KEY=

# Optional: shown to OpenRouter as the calling app, used for their leaderboards/analytics.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev-only flags. Leave unset (or "0") in production.
# MOCK_GAMES=1 serves built-in sample fixtures instead of calling the Polymarket API.
# MOCK_AI=1 returns a canned analysis instead of calling OpenRouter, so you can test the
# full UI flow without spending API credits.
MOCK_GAMES=0
MOCK_AI=0
