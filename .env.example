# Required for real AI analysis. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required for football analysis (Sports). Get a free key at https://www.football-data.org/client/register
# (free tier: 10 requests/minute, no season restriction — unlike API-Football's free plan, which
# looked equivalent on paper but actually locks every endpoint to old completed seasons and can't
# analyze a current match at all). Football's research step is built entirely from this API's
# structured match data (form, head-to-head, fixture status/score) with no fallback to web search
# if a team or fixture can't be resolved. Covers Premier League, La Liga, Bundesliga, Serie A,
# Ligue 1, Primeira Liga, Eredivisie, and the Champions League — not Belgian Pro League, which has
# no free-tier code.
FOOTBALL_DATA_API_KEY=

# Optional: enables the injuries/availability section of the football digest. football-data.org
# above has no injuries endpoint at any tier, so this comes from a separate provider, Big Balls
# Sports Data — get a free key at https://bigballsdata.com (no card required). Covers Premier
# League, La Liga, Bundesliga, Serie A, Ligue 1, and the Champions League — not Primeira Liga,
# Eredivisie, or Belgian Pro League. Left unset, the digest just says injury data isn't available
# rather than failing the analysis; this is an enrichment layer, not a required core data source.
BIG_BALLS_API_KEY=

# Optional: shown to OpenRouter as the calling app, used for their leaderboards/analytics.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev-only flags. Leave unset (or "0") in production.
# MOCK_GAMES=1 serves built-in sample fixtures instead of calling the Polymarket API.
# MOCK_AI=1 returns a canned analysis instead of calling OpenRouter, so you can test the
# full UI flow without spending API credits.
MOCK_GAMES=0
MOCK_AI=0
